# Copy to .env and fill. Never commit .env.
# OpenRouter API key for the teacher model.
OPENROUTER_API_KEY=
# OpenRouter model slug, for example provider/model-name.
TEACHER_MODEL=
# Hugging Face token with write scope on HF_BUCKET.
HF_TOKEN=
# Target bucket id, for example user/bucket-name.
HF_BUCKET=
# Optional: OpenRouter OpenAI-compatible base URL.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: concurrent tasks (set to 1 for quick-test).
MAX_CONCURRENCY=8
